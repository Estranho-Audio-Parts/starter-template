# Copie este arquivo para .env.local e preencha com os dados do SEU projeto.
#   cp .env.example .env.local
#
# Os valores estao no painel do Supabase, em Project Settings > API.
# Crie o projeto em https://database.new

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ATENCAO
# Tudo que comeca com NEXT_PUBLIC_ e enviado para o navegador de quem abre o
# site. Isso e esperado para as duas variaveis acima.
#
# A chave "service_role" (ou "secret") do painel NAO vai aqui e NAO vai em
# lugar nenhum deste projeto: ela ignora todas as regras de seguranca do banco.
#
# .env.local esta no .gitignore. Nunca comite esse arquivo.
